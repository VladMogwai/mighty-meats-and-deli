{
  "name": "mighty-meats-and-deli",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --parallel --filter @mighty-meats/cms --filter @mighty-meats/web dev",
    "dev:cms": "pnpm --filter @mighty-meats/cms dev",
    "dev:web": "pnpm --filter @mighty-meats/web dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver"]
  }
}
