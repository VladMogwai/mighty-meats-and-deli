# Postgres connection string. Local: docker-compose (pnpm db:up).
# Supabase: Project Settings → Database → Connection string → "Session pooler" (IPv4, port 5432)
DATABASE_URL=postgres://postgres:postgres@localhost:54322/mighty_meats
# Random string, generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# Public origin of this CMS (Render URL in production)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
# Public origin of the website (Cloudflare Pages URL or custom domain)
WEB_URL=http://localhost:3000
# Cloudflare Pages deploy hook — site rebuilds after content changes. Empty = disabled.
WEB_DEPLOY_HOOK_URL=

# Supabase Storage (S3 protocol). Empty = files are stored on local disk.
# Supabase: Storage → Settings → S3 Connection / S3 Access Keys
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
S3_PUBLIC_URL=
